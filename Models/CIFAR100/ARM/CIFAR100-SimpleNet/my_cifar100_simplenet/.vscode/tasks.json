{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "${config:MAXIM_PATH}/Tools/MSYS2/usr/bin/make.exe",
      "args": [
        "-r",
        "-j",
        "8",
        "--output-sync=target",
        "--no-print-directory",
        "TARGET=${config:target}",
        "BOARD=${config:board}",
        "MAXIM_PATH=${config:MAXIM_PATH}",
        "MAKE=make",
        "PROJECT=${config:project_name}"
      ],
      "options": {
        "env": {
          "PATH": "${config:MAXIM_PATH}/Tools/GNUTools/10.3/bin;${config:MAXIM_PATH}/Tools/MSYS2/usr/bin;${config:OCD_path};${env:PATH}"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "${config:MAXIM_PATH}/Tools/MSYS2/usr/bin/make.exe",
      "args": [
        "-j",
        "8",
        "clean",
        "--output-sync=target",
        "--no-print-directory",
        "TARGET=${config:target}",
        "BOARD=${config:board}",
        "MAXIM_PATH=${config:MAXIM_PATH}",
        "MAKE=make",
        "PROJECT=${config:project_name}"
      ],
      "options": {
        "env": {
          "PATH": "${config:MAXIM_PATH}/Tools/GNUTools/10.3/bin;${config:MAXIM_PATH}/Tools/MSYS2/usr/bin;${config:OCD_path};${env:PATH}"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "clean-periph",
      "type": "shell",
      "command": "${config:MAXIM_PATH}/Tools/MSYS2/usr/bin/make.exe",
      "args": [
        "-j",
        "8",
        "distclean",
        "--output-sync=target",
        "--no-print-directory",
        "TARGET=${config:target}",
        "BOARD=${config:board}",
        "MAXIM_PATH=${config:MAXIM_PATH}",
        "MAKE=make",
        "PROJECT=${config:project_name}"
      ],
      "options": {
        "env": {
          "PATH": "${config:MAXIM_PATH}/Tools/GNUTools/10.3/bin;${config:MAXIM_PATH}/Tools/MSYS2/usr/bin;${config:OCD_path};${env:PATH}"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "flash",
      "type": "shell",
      "command": "${config:MAXIM_PATH}/Tools/GNUTools/10.3/bin/arm-none-eabi-gdb.exe",
      "args": [
        "--cd=\"${workspaceFolder}\"",
        "--se=\"build/${config:program_file}\"",
        "--symbols=build/${config:symbol_file}",
        "-x=\"${workspaceFolder}/.vscode/flash.gdb\"",
        "--ex=\"flash_m4 ${config:OCD_path} ${config:M4_OCD_interface_file} ${config:M4_OCD_target_file}\"",
        "--batch"
      ],
      "options": {
        "env": {
          "PATH": "${config:MAXIM_PATH}/Tools/GNUTools/10.3/bin;${config:OCD_path};${env:PATH}"
        }
      },
      "group": "build",
      "problemMatcher": [],
      "dependsOn": ["build"]
    },
    {
      "label": "flash & run",
      "type": "shell",
      "command": "${config:MAXIM_PATH}/Tools/GNUTools/10.3/bin/arm-none-eabi-gdb.exe",
      "args": [
        "--cd=\"${workspaceFolder}\"",
        "--se=\"build/${config:program_file}\"",
        "--symbols=build/${config:symbol_file}",
        "-x=\"${workspaceFolder}/.vscode/flash.gdb\"",
        "--ex=\"flash_m4_run ${config:OCD_path} ${config:M4_OCD_interface_file} ${config:M4_OCD_target_file}\"",
        "--batch"
      ],
      "options": {
        "env": {
          "PATH": "${config:MAXIM_PATH}/Tools/GNUTools/10.3/bin;${config:OCD_path};${env:PATH}"
        }
      },
      "group": "build",
      "problemMatcher": [],
      "dependsOn": ["build"]
    },
    {
      "label": "erase flash",
      "type": "shell",
      "command": "${config:OCD_path}/openocd.exe",
      "args": [
        "-s",
        "${config:OCD_path}/scripts",
        "-f",
        "interface/${config:M4_OCD_interface_file}",
        "-f",
        "target/${config:M4_OCD_target_file}",
        "-c",
        "\"init; reset halt; max32xxx mass_erase 0;\"",
        "-c",
        "exit"
      ],
      "group": "build",
      "problemMatcher": [],
      "dependsOn": []
    },
    {
      "label": "openocd (m4)",
      "type": "shell",
      "command": "${config:OCD_path}/openocd.exe",
      "args": [
        "-s",
        "${config:OCD_path}/scripts",
        "-f",
        "interface/${config:M4_OCD_interface_file}",
        "-f",
        "target/${config:M4_OCD_target_file}",
        "-c",
        "\"init; reset halt\""
      ],
      "problemMatcher": [],
      "dependsOn": []
    },
    {
      "label": "gdb (m4)",
      "type": "shell",
      "command": "${config:MAXIM_PATH}/Tools/GNUTools/10.3/bin/arm-none-eabi-gdb.exe",
      "args": [
        "--ex=\"cd ${workspaceFolder}\"",
        "--se=\"build/${config:program_file}\"",
        "--symbols=build/${config:symbol_file}",
        "--ex=\"target remote localhost:3333\"",
        "--ex=\"monitor reset halt\"",
        "--ex=\"b main\"",
        "--ex=\"c\""
      ],
      "options": {
        "env": {
          "PATH": "${config:MAXIM_PATH}/Tools/GNUTools/10.3/bin;${config:OCD_path};${env:PATH}"
        }
      },
      "problemMatcher": [],
      "dependsOn": []
    }
  ]
}
